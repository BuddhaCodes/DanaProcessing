<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DanaProcessing</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package metadata. -->
  <PropertyGroup>
    <PackageId>DanaProcessing</PackageId>
    <Version>1.0.0</Version>
    <Authors>BuddhaCodes</Authors>
    <Description>Cross-platform creative-coding core for C#, inspired by Processing — 2D (SkiaSharp) and 3D (Silk.NET/OpenGL) rendering behind one Sketch API. No UI dependency of its own: use DanaProcessing.AvaloniaHost to run a sketch in a window or embeddable control.</Description>
    <PackageTags>creative-coding;graphics;processing;skiasharp;opengl</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <!-- Same SkiaSharp as Avalonia 12.0.5 loads at runtime (it requires >= 3.119.4).
         One version everywhere: compiling against 2.88 while 3.x runs caused MissingMethodExceptions. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- SVG loading for LoadShape(). Svg.Skia replaces the unmaintained SkiaSharp.Svg 1.60 (built for SkiaSharp 1.x). -->
    <PackageReference Include="Svg.Skia" Version="3.7.0" />
  </ItemGroup>

</Project>
