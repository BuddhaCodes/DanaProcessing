<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DanaProcessing</RootNamespace>
  </PropertyGroup>

  <!-- NuGet package metadata. -->
  <PropertyGroup>
    <PackageId>DanaProcessing</PackageId>
    <Version>1.0.0</Version>
    <Description>Cross-platform creative-coding core for C#, inspired by Processing — 2D (SkiaSharp) and 3D (Silk.NET/OpenGL) rendering behind one Sketch API. No UI dependency of its own: use DanaProcessing.AvaloniaHost to run a sketch in a window or embeddable control.</Description>
    <PackageTags>creative-coding;graphics;processing;skiasharp;opengl</PackageTags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- XML docs ship in the package, so editors show the API's explanations. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574;CS1584;CS1580;CS1581;CS1587;CS1570;CS1734;CS1711;CS1712;CS1723</NoWarn>
  </PropertyGroup>

  <Import Project="..\packaging\Package.props" />

  <ItemGroup>
    <!-- `using DanaProcessing;` for free in projects that use the package (like sketches get in the IDE). -->
    <None Include="buildTransitive\DanaProcessing.props" Pack="true" PackagePath="buildTransitive\DanaProcessing.props" />
    <None Include="buildTransitive\DanaProcessing.props" Pack="true" PackagePath="build\DanaProcessing.props" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <!-- Same SkiaSharp as Avalonia 12.0.5 loads at runtime (it requires >= 3.119.4).
         One version everywhere: compiling against 2.88 while 3.x runs caused MissingMethodExceptions. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <!-- SVG loading for LoadShape(). Svg.Skia replaces the unmaintained SkiaSharp.Svg 1.60 (built for SkiaSharp 1.x). -->
    <PackageReference Include="Svg.Skia" Version="3.7.0" />
  </ItemGroup>

</Project>
