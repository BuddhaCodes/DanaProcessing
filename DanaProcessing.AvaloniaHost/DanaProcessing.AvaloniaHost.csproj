<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DanaProcessing.AvaloniaHost</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>DanaProcessing.AvaloniaHost</PackageId>
    <Version>1.0.0</Version>
    <Description>Runs DanaProcessing sketches anywhere: SketchApp.Run() opens a sketch in its own window from any .NET program; AvaloniaSketchCanvas embeds one in your Avalonia app. Windows, macOS and Linux.</Description>
    <PackageTags>creative-coding;graphics;processing;avalonia;sketch</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572;CS1574;CS1584;CS1580;CS1581;CS1587;CS1570;CS1734;CS1711;CS1712;CS1723</NoWarn>
  </PropertyGroup>

  <Import Project="..\packaging\Package.props" />

  <ItemGroup>
    <!--
      No SkiaSharp.Views.Avalonia here: that package doesn't exist. Avalonia's
      Skia interop comes from Avalonia.Skia (pulled in transitively by
      Avalonia.Desktop below), which exposes ISkiaSharpApiLeaseFeature.
      We still need plain SkiaSharp for the SKCanvas/SKPaint types themselves.
    -->
    <!--
      Avalonia.Desktop 12.0.5 -> Avalonia.Skia 12.0.5 requires SkiaSharp >= 3.119.4.
      The core library pins the very same version, so everything compiles
      against the SkiaSharp that actually runs.
    -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <!-- The look of the window SketchApp opens (a Window needs a theme to show its content). -->
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <ProjectReference Include="..\DanaProcessing\DanaProcessing.csproj" />
  </ItemGroup>

</Project>
