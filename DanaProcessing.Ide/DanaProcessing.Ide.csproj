<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Product>DanaProcessing IDE</Product>
    <!-- The .exe's own Win32 icon resource: what Explorer, the taskbar,
         and alt-tab show. Needs a real multi-resolution .ico file (not
         .png) at build time; dana.ico is generated from dana.png (16 to
         256px, PNG-compressed frames): regenerate it the same way if
         dana.png ever changes. -->
    <ApplicationIcon>Theme\dana.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as an Avalonia resource (avares://) so MainWindow can load
         it at runtime for Window.Icon too: belt and suspenders alongside
         ApplicationIcon above, and the only option for anything Avalonia
         itself draws (e.g. a future in-app "About" dialog), since that API
         needs an IBitmap/stream, not a Win32 resource. -->
    <AvaloniaResource Include="Theme\dana.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API reference (Sketch/PVector/etc. method docs), embedded so
         Agent/ApiDocsIndex.cs can load it via Assembly.GetManifestResourceStream
         regardless of the working directory a published exe runs from:
         confirmed nothing in this project referenced index.html before this,
         so it wasn't shipped/locatable at runtime at all until now. -->
    <EmbeddedResource Include="..\index.html" LogicalName="DanaProcessing.Ide.index.html" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled fonts (SIL Open Font License, texts alongside): Andika for the
         Fichas blocks view, Atkinson Hyperlegible for Renglones and the blocks
         editor chrome, IBM Plex Mono for the C# shown beside the blocks.
         Embedded twice: as manifest resources for the Skia-drawn canvas
         (BundledFonts) and as avares:// resources for Avalonia text. -->
    <EmbeddedResource Include="Theme\Fonts\*.ttf" LogicalName="DanaProcessing.Ide.Fonts.%(Filename)%(Extension)" />
    <AvaloniaResource Include="Theme\Fonts\*.ttf" />
    <None Include="Theme\Fonts\OFL-*.txt" CopyToOutputDirectory="PreserveNewest" Link="Licenses\Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach internal helpers (agent message repair, URL parsing...). -->
    <InternalsVisibleTo Include="DanaProcessing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
	  <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
	  <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.9.0" />
	  <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
	  <PackageReference Include="TextMateSharp.Grammars" Version="2.0.3" />
	  <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
	  <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
	  <PackageReference Include="NuGet.Protocol" Version="7.9.0" />
	  <!-- NuGet.Packaging 7.9 pulls System.Security.Cryptography.Pkcs 8.0.1, which has known
	       vulnerabilities (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7): pin the patched .NET 10 build. -->
	  <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
	  <PackageReference Include="Velopack" Version="1.2.161" />
    <ProjectReference Include="..\DanaProcessing.AvaloniaHost\DanaProcessing.AvaloniaHost.csproj" />
  </ItemGroup>
</Project>
