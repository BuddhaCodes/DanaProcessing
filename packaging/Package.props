<Project>
  <!--
    Shared NuGet metadata for the packages built from this repo
    (DanaProcessing, DanaProcessing.AvaloniaHost, DanaProcessing.Templates).
    Imported by each packable project; the version comes from the tag in
    .github/workflows/publish-packages.yml (dotnet pack -p:Version=...).
  -->
  <PropertyGroup>
    <Authors>BuddhaCodes</Authors>
    <Company>DanaProcessing</Company>
    <Copyright>Copyright (c) 2026 Dana Processing</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://buddhacodes.github.io/DanaProcessing/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/BuddhaCodes/DanaProcessing</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
