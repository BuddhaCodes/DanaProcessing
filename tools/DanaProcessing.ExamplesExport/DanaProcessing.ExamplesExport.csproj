<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Writes the IDE's sample catalog (SketchSamples.All) as JSON for the VS Code
    extension's "Open an example" command. Run this project with the output
    path as its argument: vscode-extension/examples.json
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DanaProcessing.Ide\DanaProcessing.Ide.csproj" />
  </ItemGroup>

</Project>
